# Скопируй в .env и заполни. В проде переменные задаются в окружении сервера.

# --- Django ---
# Настройки: config.settings.dev (локально) или config.settings.prod (сервер)
DJANGO_SETTINGS_MODULE=config.settings.dev
# Сгенерируй: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Через запятую. В проде — реальный домен.
ALLOWED_HOSTS=localhost,127.0.0.1
# Для прода: https://example.uz,https://www.example.uz
CSRF_TRUSTED_ORIGINS=

# --- База данных ---
DATABASE_URL=postgres://postgres:postgres@db:5432/shop
# Используются docker-compose для инициализации контейнера postgres
POSTGRES_DB=shop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Владелец магазина (доступ в админку) ---
# Единственный вход в систему — публичной регистрации нет.
# При деплое `manage.py ensure_owner` создаст/обновит этого суперпользователя.
OWNER_USERNAME=owner
OWNER_PASSWORD=change-me-strong-password
OWNER_EMAIL=owner@example.uz

# --- Безопасность (только прод) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
