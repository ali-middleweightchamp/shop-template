{
  "name": "shop-template",
  "version": "1.0.0",
  "private": true,
  "description": "Шаблон интернет-каталога — сборка Tailwind CSS",
  "scripts": {
    "build:css": "tailwindcss -i ./static/src/input.css -o ./static/dist/css/app.css --minify",
    "watch:css": "tailwindcss -i ./static/src/input.css -o ./static/dist/css/app.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "postcss-import": "^16.1.0",
    "tailwindcss": "^3.4.0"
  }
}
